<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Logging — <%= guildName %></title>
<link rel="icon" type="image/png" href="/favicon.png">
<%- include('partials/styles') %>
</head>
<body>
<%- include('partials/sidebar', { activeModule: 'logging' }) %>
<%- include('partials/topbar', { pageLabel: 'Logging' }) %>

      <form action="/dashboard/<%= guildId %>/logging" method="POST">
        <div class="glass panel">
          <div class="panel-head"><h2><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-3px;margin-right:6px;flex-shrink:0;"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>Logging</h2></div>
          <p class="cmd-note" style="margin-top:-8px;">Where anti-nuke and automod actions get reported.</p>
          <select name="channelId">
            <option value="">— None —</option>
            <% guildTextChannels.forEach(c => { %><option value="<%= c.id %>" <%= logChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option><% }) %>
          </select>
          <button type="submit" class="save-btn">Save Log Channel</button>
        </div>
      </form>

<%- include('partials/foot') %>
</body>
</html>
