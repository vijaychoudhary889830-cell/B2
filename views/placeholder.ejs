<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1">
<title><%= title %> — SPIDEY</title>
<link rel="icon" type="image/png" href="/favicon.png">
<style>
  :root {
    --bg: #000000; --bg2: #0a0a0a; --card: #ffffff; --border: #e2e8f0;
    --text: #1b2733; --muted: #64758a; --page-text: #f4f6fa;
    --accent: #38a3ff; --accent2: #8fd8ff;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background:
      radial-gradient(circle at 15% -10%, #141414 0%, transparent 45%),
      radial-gradient(circle at 90% 10%, #0d1f33 0%, transparent 40%),
      linear-gradient(180deg, var(--bg), var(--bg2));
    color: var(--page-text); font-family: 'Segoe UI', system-ui, sans-serif; min-height: 100vh;
  }
  nav {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 32px; border-bottom: 1px solid rgba(255,255,255,0.12);
    background: #000000; color: #ffffff;
  }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 17px; }
  .brand-logo { width: 30px; height: 30px; border-radius: 9px; object-fit: cover; border: 1px solid rgba(255,255,255,0.18); box-shadow: 0 4px 14px rgba(56,163,255,0.35); flex-shrink: 0; }
  .brand-badge {
    width: 30px; height: 30px; border-radius: 8px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    box-shadow: 0 4px 14px rgba(56,163,255,0.4), inset 0 1px 0 rgba(255,255,255,0.7);
    display: flex; align-items: center; justify-content: center; font-size: 15px;
  }
  .nav-links { display: flex; align-items: center; gap: 22px; }
  .nav-links a { color: #cfe4ff; text-decoration: none; font-size: 13.5px; font-weight: 600; }
  .nav-links a:hover { color: #ffffff; }
  .nav-links a.btn, .nav-links a.btn:hover { color: #06283f; }
  .btn { padding: 9px 18px; border-radius: 9px; font-weight: 700; text-decoration: none; font-size: 13px;
    background: linear-gradient(180deg, var(--accent2), var(--accent)); color: #06283f;
    box-shadow: 0 4px 14px rgba(56,163,255,0.35), inset 0 1px 0 rgba(255,255,255,0.6); }

  .wrap { max-width: 560px; margin: 0 auto; padding: 110px 24px 60px; text-align: center; }
  .icon { font-size: 42px; margin-bottom: 16px; }
  h1 { font-size: 24px; margin: 0 0 10px; }
  p { color: var(--muted); font-size: 14.5px; line-height: 1.6; margin: 0 0 26px; }
  .tag {
    display: inline-block; padding: 6px 14px; border-radius: 999px; font-size: 12px; font-weight: 700;
    background: rgba(56,163,255,0.1); color: #1483d6; border: 1px solid rgba(56,163,255,0.3); margin-bottom: 18px;
  }

  html { overflow-x: hidden; }
  .hamburger { display: none; width: 40px; height: 40px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.18); background: rgba(255,255,255,0.05); color: #fff; font-size: 18px; cursor: pointer; }
  .drawer-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 30; }
  .drawer { position: fixed; top: 0; right: 0; height: 100%; width: min(270px, 86vw); z-index: 40; visibility: hidden; background: #0a0a0a; border-left: 1px solid rgba(255,255,255,0.12); padding: 22px 20px; transform: translateX(100%); transition: transform .25s ease, visibility 0s linear .25s; display: flex; flex-direction: column; gap: 2px; }
  .drawer.open { transform: translateX(0); visibility: visible; transition: transform .25s ease, visibility 0s; }
  .drawer-overlay.open { display: block; }
  .drawer a { color: #cfe4ff; text-decoration: none; padding: 13px 6px; font-weight: 600; font-size: 15px; border-bottom: 1px solid rgba(255,255,255,0.10); }
  .drawer a.btn { margin-top: 16px; border: none; text-align: center; padding: 12px 18px; color: #06283f; }
  .drawer-close { align-self: flex-end; background: none; border: none; color: #fff; font-size: 22px; cursor: pointer; margin-bottom: 8px; }
  nav .brand { white-space: nowrap; }
  @media (max-width: 820px) {
    nav { padding: 14px 18px; }
    .nav-links { display: none; }
    .hamburger { display: block; }
  }
  /* Shop icon, top right */
  .nav-actions { display: flex; align-items: center; gap: 10px; }
  .nav-icon { width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--line); background: rgba(255,255,255,0.04); color: var(--text); display: flex; align-items: center; justify-content: center; text-decoration: none; transition: border-color .15s, color .15s; }
  .nav-icon:hover { border-color: rgba(255,59,78,0.6); color: var(--red-soft); }
</style>

</head>
<body>
  <nav>
    <div class="brand"><img class="brand-logo" src="/logo.png" alt="SPIDEY"> SPIDEY</div>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/status">Status</a>
      <a href="/about">About</a>
      <a href="/documentation">Docs</a>
      <a href="/support">Support</a>
      <% if (user) { %><a href="/dashboard" class="btn">Dashboard</a><% } else { %><a href="/login" class="btn">Login</a><% } %>
    </div>
    <div class="nav-actions"><%- include('partials/home-btn') %><a class="nav-icon" href="/shop" aria-label="Shop" title="Shop"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></a><button class="hamburger" aria-label="Open menu" onclick="toggleDrawer(true)">☰</button></div>
  </nav>

  <div class="drawer-overlay" id="overlay" onclick="toggleDrawer(false)"></div>
  <div class="drawer" id="drawer">
    <button class="drawer-close" aria-label="Close menu" onclick="toggleDrawer(false)">✕</button>
    <a href="/">Home</a>
    <a href="/dashboard">Dashboard</a>
    <a href="/status">Status</a>
    <a href="/about">About</a>
    <a href="/documentation">Docs</a>
    <a href="/support">Support</a>
    <% if (user) { %><a href="/dashboard" class="btn">Dashboard</a><% } else { %><a href="/login" class="btn">Login</a><% } %>
  </div>


  <div class="wrap">
    <div class="tag"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-3px;margin-right:6px;flex-shrink:0;"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"/></svg>In Progress</div>
    <div class="icon"><%= icon %></div>
    <h1><%= title %></h1>
    <p><%= message %></p>
    <a href="/" class="btn">← Back to Home</a>
  </div>

  <script>
    function toggleDrawer(open) {
      document.getElementById('drawer').classList.toggle('open', open);
      document.getElementById('overlay').classList.toggle('open', open);
    }
  </script>
</body>
</html>
