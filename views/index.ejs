      <defs>
        <linearGradient id="cA" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#a14a3c"/><stop offset=".35" stop-color="#6b2a2a"/><stop offset="1" stop-color="#2a1016"/></linearGradient>
