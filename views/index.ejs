        <linearGradient id="cC" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4f1f26"/><stop offset=".45" stop-color="#2b1017"/><stop offset="1" stop-color="#0d0609"/></linearGradient>
        <linearGradient id="cfade" x1="0" y1="0" x2="0" y2="1"><stop offset=".5" stop-color="#08060a" stop-opacity="0"/><stop offset=".95" stop-color="#08060a" stop-opacity="1"/></linearGradient>
        <filter id="fur" x="-4%" y="-40%" width="108%" height="180%" color-interpolation-filters="sRGB">
          <feTurbulence type="fractalNoise" baseFrequency="0.014 0.03" numOctaves="3" seed="4" result="warp"/>
          <feDisplacementMap in="SourceGraphic" in2="warp" scale="52" xChannelSelector="R" yChannelSelector="G" result="shape"/>
          <feTurbulence type="fractalNoise" baseFrequency="0.22" numOctaves="2" seed="2" result="fine"/>
          <feDisplacementMap in="shape" in2="fine" scale="14" xChannelSelector="G" yChannelSelector="R" result="rough"/>
          <feTurbulence type="fractalNoise" baseFrequency="0.7" numOctaves="2" seed="9" result="grain"/>
          <feColorMatrix in="grain" type="matrix" values="0.9 0 0 0 0.25  0.9 0 0 0 0.25  0.9 0 0 0 0.25  0 0 0 0 1" result="grainG"/>
          <feBlend in="rough" in2="grainG" mode="multiply" result="tex"/>
          <feComposite in="tex" in2="rough" operator="in"/>
        </filter>
      </defs>
      <g class="c1" fill="url(#cA)" filter="url(#fur)"><circle cx="-90" cy="123" r="48"/><circle cx="-32" cy="120" r="49"/><circle cx="16" cy="121" r="37"/><circle cx="65" cy="102" r="62"/><circle cx="105" cy="134" r="34"/><circle cx="156" cy="141" r="32"/><circle cx="215" cy="125" r="56"/><circle cx="250" cy="121" r="31"/><circle cx="283" cy="109" r="38"/><circle cx="315" cy="117" r="49"/><circle cx="371" cy="126" r="51"/><circle cx="416" cy="118" r="56"/><circle cx="455" cy="142" r="70"/><circle cx="510" cy="112" r="58"/><circle cx="548" cy="101" r="42"/><circle cx="601" cy="135" r="46"/><circle cx="644" cy="135" r="68"/><circle cx="675" cy="138" r="38"/><circle cx="719" cy="115" r="69"/><circle cx="753" cy="132" r="55"/><circle cx="792" cy="113" r="33"/><circle cx="850" cy="103" r="60"/><circle cx="889" cy="101" r="34"/><circle cx="943" cy="123" r="37"/><circle cx="987" cy="130" r="38"/><circle cx="1022" cy="103" r="56"/><circle cx="1065" cy="110" r="39"/><circle cx="1124" cy="111" r="62"/><circle cx="1180" cy="115" r="38"/><circle cx="1236" cy="102" r="56"/><circle cx="1295" cy="109" r="39"/><circle cx="1349" cy="111" r="43"/><circle cx="1382" cy="124" r="34"/><circle cx="1420" cy="114" r="54"/><circle cx="1464" cy="119" r="68"/><circle cx="1512" cy="106" r="65"/><circle cx="1548" cy="134" r="66"/><circle cx="1586" cy="131" r="38"/><circle cx="1644" cy="140" r="38"/><circle cx="1700" cy="117" r="54"/><rect x="-120" y="120" width="1840" height="330"/></g>
      <g class="c2" fill="url(#cB)" filter="url(#fur)"><circle cx="-90" cy="188" r="38"/><circle cx="-43" cy="157" r="68"/><circle cx="24" cy="159" r="63"/><circle cx="69" cy="149" r="69"/><circle cx="115" cy="184" r="62"/><circle cx="175" cy="186" r="49"/><circle cx="221" cy="158" r="37"/><circle cx="275" cy="154" r="39"/><circle cx="326" cy="152" r="62"/><circle cx="377" cy="189" r="77"/><circle cx="439" cy="172" r="68"/><circle cx="482" cy="147" r="38"/><circle cx="553" cy="188" r="68"/><circle cx="592" cy="167" r="65"/><circle cx="656" cy="190" r="51"/><circle cx="697" cy="178" r="61"/><circle cx="767" cy="177" r="70"/><circle cx="833" cy="161" r="78"/><circle cx="896" cy="184" r="77"/><circle cx="949" cy="184" r="72"/><circle cx="1008" cy="163" r="65"/><circle cx="1067" cy="150" r="64"/><circle cx="1127" cy="185" r="82"/><circle cx="1191" cy="178" r="54"/><circle cx="1250" cy="183" r="56"/><circle cx="1292" cy="147" r="71"/><circle cx="1351" cy="156" r="58"/><circle cx="1414" cy="173" r="59"/><circle cx="1485" cy="146" r="48"/><circle cx="1534" cy="155" r="67"/><circle cx="1578" cy="175" r="78"/><circle cx="1632" cy="160" r="77"/><circle cx="1694" cy="165" r="45"/><rect x="-120" y="168" width="1840" height="330"/></g>
      <g class="c3" fill="url(#cC)" filter="url(#fur)"><circle cx="-90" cy="237" r="92"/><circle cx="-25" cy="215" r="74"/><circle cx="29" cy="235" r="70"/><circle cx="114" cy="240" r="81"/><circle cx="174" cy="220" r="53"/><circle cx="235" cy="219" r="55"/><circle cx="310" cy="215" r="70"/><circle cx="395" cy="220" r="95"/><circle cx="446" cy="237" r="46"/><circle cx="496" cy="225" r="81"/><circle cx="558" cy="203" r="85"/><circle cx="612" cy="203" r="68"/><circle cx="696" cy="208" r="56"/><circle cx="746" cy="220" r="77"/><circle cx="822" cy="234" r="78"/><circle cx="912" cy="210" r="80"/><circle cx="981" cy="202" r="53"/><circle cx="1050" cy="209" r="81"/><circle cx="1110" cy="230" r="62"/><circle cx="1181" cy="232" r="76"/><circle cx="1246" cy="238" r="85"/><circle cx="1298" cy="231" r="92"/><circle cx="1352" cy="227" r="68"/><circle cx="1440" cy="225" r="64"/><circle cx="1526" cy="240" r="85"/><circle cx="1595" cy="210" r="78"/><circle cx="1674" cy="228" r="87"/><rect x="-120" y="222" width="1840" height="330"/></g>
      <rect x="0" y="0" width="1600" height="330" fill="url(#cfade)"/>
    </svg>
    </div>
    </section>

    <section id="features">
      <h2>Protection that acts, not just logs</h2>
      <p class="section-lead">Everything runs per server, so each community keeps its own rules.</p>
      <div class="features">
        <div class="anchor pop">
          <h3>Anti-nuke</h3>
          <p>Catches the actions that destroy a server and punishes the account responsible, automatically.</p>
          <ul>
            <li>Mass bans and kicks</li><li>Channel deletion</li><li>Role wipes</li><li>Webhook abuse</li>
            <li>Bot additions</li><li>Permission changes</li>
          </ul>
        </div>
        <div class="list">
          <div class="item pop"><h3>AutoMod</h3><p>Spam, caps, banned words, invite links and raid detection, each with its own switch.</p></div>
          <div class="item pop"><h3>Tickets</h3><p>Private support channels in one click, with a saved transcript when a ticket closes.</p></div>
          <div class="item pop"><h3>Reaction roles</h3><p>Post a panel, link emojis to roles, and members pick their own.</p></div>
          <div class="item pop"><h3>Music</h3><p>Play from YouTube and Spotify links with <code>!play</code> or slash commands, plus 24/7 mode.</p></div>
          <div class="item pop"><h3>Whitelist and owners</h3><p>Exempt trusted staff, or give extra owners full access.</p></div>
        </div>
      </div>
    </section>

    <section id="premium">
      <div class="premium pop">
        <div>
          <h2>Make the bot yours</h2>
          <p class="section-lead" style="margin-bottom:0">Premium gives Spidey its own look in your server only.</p>
          <ul class="perks">
            <li>Custom bot name and bio</li>
            <li>Your own avatar and banner</li>
            <li>Switches on the moment you pay</li>
          </ul>
          <div class="price">$<%= usdTxt %> <small>for <%= premiumDays %> days, per server</small></div>
          <p style="margin:6px 0 0;color:var(--muted);font-size:14px;">or ₹<%= priceInr %> in India. 7-day, 4-month and lifetime plans are in the <a href="/shop" style="color:var(--red-soft);">Shop</a>.</p>
          <div style="margin-top:20px">
            <% if (user) { %><a href="/shop" class="btn btn-primary">See plans</a>
            <% } else { %><a href="/login?next=/shop" class="btn btn-primary">Log in to buy</a><% } %>
          </div>
        </div>
        <div class="profile" aria-hidden="true">
          <div class="banner"></div>
          <img class="av" src="/logo.png" alt="">
          <div class="who"><b>Your bot's name</b><p>A bio you write, shown on the bot's profile in your server.</p></div>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/site-footer') %>

  <script>
    function toggleDrawer(open) {
      document.getElementById('drawer').classList.toggle('open', open);
      document.getElementById('overlay').classList.toggle('open', open);
    }
    (function () {
      var events = [
        ['Mass ban attempt', 'block', 'Blocked'], ['Channel deleted by new admin', 'undo', 'Restored'],
        ['Invite link spam', 'block', 'Deleted'], ['Raid: 14 joins in 8s', 'block', 'Locked down'],
        ['Role permissions changed', 'undo', 'Reverted'], ['Unknown bot added', 'block', 'Kicked'],
        ['Webhook created', 'block', 'Removed'], ['Ticket closed', 'ok', 'Saved'],
        ['Banned word posted', 'block', 'Deleted'], ['Caps spam', 'block', 'Timed out']
      ];
      var body = document.getElementById('logBody'), i = 0;
      function stamp(offset) { var d = new Date(Date.now() - offset * 1000); return d.toTimeString().slice(0, 5); }
      function add(offset) {
        var e = events[i++ % events.length], row = document.createElement('div');
        row.className = 'log-row';
        row.innerHTML = '<time>' + stamp(offset) + '</time><span>' + e[0] + '</span><span class="tag ' + e[1] + '">' + e[2] + '</span>';
        body.appendChild(row);
        while (body.children.length > 6) body.removeChild(body.firstChild);
      }
      for (var k = 5; k >= 0; k--) add(k * 40);
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(function () { add(0); }, 2600);
    })();
    (function () {
      var c = document.getElementById('cmp');
      if (!c || !('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      c.classList.add('js-anim');
      new IntersectionObserver(function (e, o) { if (e[0].isIntersecting) { c.classList.add('in'); o.disconnect(); } }, { threshold: 0.35 }).observe(c);
    })();
    (function () {
      var sky = document.getElementById('sky'), n = window.innerWidth < 700 ? 70 : 140, frag = document.createDocumentFragment();
      for (var i = 0; i < n; i++) {
        var st = document.createElement('i'), sz = Math.random() < 0.12 ? 3 : (Math.random() < 0.5 ? 2 : 1.5);
        st.className = 'star' + (Math.random() < 0.25 ? ' warm' : '');
        st.style.cssText = 'left:' + (Math.random() * 100) + '%;top:' + (Math.random() * 100) + '%;width:' + sz + 'px;height:' + sz + 'px;--d:' + (3 + Math.random() * 5).toFixed(1) + 's;--l:-' + (Math.random() * 6).toFixed(1) + 's';
        frag.appendChild(st);
      }
      sky.appendChild(frag);
    })();
    (function () {
      var band = document.getElementById('cloudBand');
      if (!band) return;
      var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (calm || !('IntersectionObserver' in window)) { band.classList.add('in'); return; }
      new IntersectionObserver(function (e, o) { if (e[0].isIntersecting) { band.classList.add('in'); o.disconnect(); } }, { threshold: 0.15 }).observe(band);
      var svg = band.querySelector('svg'), ticking = false;
      function move() {
        var r = band.getBoundingClientRect();
        var d = (r.top + r.height / 2 - window.innerHeight / 2) * 0.14;
        svg.style.setProperty('--cp', Math.max(-36, Math.min(36, d)).toFixed(1) + 'px');
        ticking = false;
      }
      window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(move); } }, { passive: true });
      move();
    })();
    (function () {
      var items = document.querySelectorAll('.pop');
      if (!('IntersectionObserver' in window)) { items.forEach(function (el) { el.classList.add('in'); }); return; }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en, i) {
          if (en.isIntersecting) { setTimeout(function () { en.target.classList.add('in'); }, i * 70); io.unobserve(en.target); }
        });
      }, { threshold: 0.12 });
      items.forEach(function (el) { io.observe(el); });
    })();
  </script>
</body>
</html>
