<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Overview — <%= guildName %></title>
<link rel="icon" type="image/png" href="/favicon.png">
<%- include('partials/styles') %>
<style>
  .ring { position: relative; width: 78px; height: 78px; display: grid; place-items: center; flex-shrink: 0; }
  .ring::before {
    content: ''; position: absolute; inset: 0; border-radius: 50%;
    background: conic-gradient(var(--c) calc(var(--p) * 1%), rgba(255,255,255,0.08) 0);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 9px), #000 calc(100% - 8px));
            mask: radial-gradient(farthest-side, transparent calc(100% - 9px), #000 calc(100% - 8px));
  }
  .ring span { position: relative; font-size: 14px; color: var(--text); }
  .ring-lg { width: 104px; height: 104px; }
  .ring-lg::before { -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 12px), #000 calc(100% - 11px)); mask: radial-gradient(farthest-side, transparent calc(100% - 12px), #000 calc(100% - 11px)); }
  .ring-lg span { font-size: 22px; }
  .cov-total { display: flex; align-items: center; gap: 16px; padding: 4px 0 18px; border-bottom: 1px solid var(--border); margin-bottom: 18px; }
  .cov-total-text { font-size: 15px; line-height: 1.4; color: var(--text); }
  .cov-total-text small { display: block; color: var(--muted); font-size: 12.5px; margin-top: 2px; }
  .cov-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px 8px; }
  .cov-item { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 9px; }
  .cov-name { font-size: 12px; font-weight: 700; color: var(--muted); line-height: 1.3; }
</style>
</head>
<body>
<%- include('partials/sidebar', { activeModule: 'overview' }) %>
<%- include('partials/topbar', { pageLabel: 'Overview' }) %>

      <div class="glass hero">
        <div class="eyebrow">Overview</div>
        <h1><%= guildName %></h1>
        <p>Real-time server protection posture with module-level security readiness.</p>
      </div>

      <div class="glass panel">
        <div class="panel-head"><h2>Server Details</h2></div>
        <div class="field-row">
          <div><div class="field-label">Server Name</div><div class="field-value"><%= guildName %></div></div>
          <button class="copy-btn" data-copy="<%= guildName %>" onclick="copyText(this.dataset.copy, this)">📋</button>
        </div>
        <div class="field-row">
          <div><div class="field-label">Server ID</div><div class="field-value"><%= guildId %></div></div>
          <button class="copy-btn" data-copy="<%= guildId %>" onclick="copyText(this.dataset.copy, this)">📋</button>
        </div>
        <div class="stat2x2">
          <div class="stat-box"><div class="lbl"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-3px;margin-right:6px;flex-shrink:0;"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/></svg>Type</div><div class="val"><%= sizeTier %></div></div>
          <div class="stat-box"><div class="lbl"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-3px;margin-right:6px;flex-shrink:0;"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>Members</div><div class="val"><%= memberCount ?? '—' %></div></div>
          <div class="stat-box"><div class="lbl"># Channels</div><div class="val"><%= channelCount ?? '—' %></div></div>
          <div class="stat-box"><div class="lbl"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-3px;margin-right:6px;flex-shrink:0;"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>Roles</div><div class="val"><%= roleCount ?? '—' %></div></div>
        </div>
      </div>

      <div class="glass panel">
        <div class="panel-head"><h2>Protection Readiness</h2></div>
        <% const antinukePct = antinukeTotal ? Math.round((antinukeEnabled / antinukeTotal) * 100) : 0; %>
        <% const automodPct = automodTotalCount ? Math.round((automodOnCount / automodTotalCount) * 100) : 0; %>
        <% const whitelistPct = whitelistCount > 0 ? 100 : 0; %>
        <div class="bar-row"><div class="bar-top"><span>Nuke Protection</span><span style="color:var(--warn)"><%= antinukePct %>%</span></div><div class="bar-track"><div class="bar-fill" style="width:<%= antinukePct %>%;background:var(--warn)"></div></div></div>
        <div class="bar-row"><div class="bar-top"><span>AutoMod</span><span style="color:var(--accent)"><%= automodPct %>%</span></div><div class="bar-track"><div class="bar-fill" style="width:<%= automodPct %>%;background:var(--accent)"></div></div></div>
        <div class="bar-row"><div class="bar-top"><span>Whitelist Configured</span><span style="color:var(--good)"><%= whitelistPct %>%</span></div><div class="bar-track"><div class="bar-fill" style="width:<%= whitelistPct %>%;background:var(--good)"></div></div></div>
      </div>

      <div class="glass panel">
        <div class="panel-head"><h2>Anti-Nuke Coverage by Category</h2></div>
        <p class="cmd-note" style="margin:-8px 0 14px;">Live from your protection config — manage on the <a href="/dashboard/<%= guildId %>/antinuke" style="color:var(--red2);text-decoration:underline;">Antinuke page</a>.</p>
        <% const covOn = categoryChart.reduce((n, c) => n + c.enabled, 0);
           const covAll = categoryChart.reduce((n, c) => n + c.total, 0);
           const covPct = covAll ? Math.round((covOn / covAll) * 100) : 0;
           const covCol = covAll && covOn === covAll ? 'var(--good)' : (covOn === 0 ? 'var(--danger)' : 'var(--warn)'); %>
        <div class="cov-total">
          <div class="ring ring-lg" style="--p:<%= covPct %>;--c:<%= covCol %>"><span><b><%= covPct %>%</b></span></div>
          <div class="cov-total-text"><b><%= covOn %> of <%= covAll %></b> protections enabled<small>across <%= categoryChart.length %> categories</small></div>
        </div>
        <div class="cov-grid">
          <% categoryChart.forEach(function (c) {
            const pct = c.total ? Math.round((c.enabled / c.total) * 100) : 0;
            const col = c.total && c.enabled === c.total ? 'var(--good)' : (c.enabled === 0 ? 'var(--danger)' : 'var(--warn)'); %>
          <div class="cov-item">
            <div class="ring" style="--p:<%= pct %>;--c:<%= col %>"><span><b><%= c.enabled %>/<%= c.total %></b></span></div>
            <div class="cov-name"><%= c.category %></div>
          </div>
          <% }); %>
        </div>
      </div>

<%- include('partials/foot') %>

</body>
</html>