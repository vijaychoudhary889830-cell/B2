      <div class="topbar">
        <div style="display:flex; align-items:center; gap:12px;">
          <button class="menu-btn" onclick="toggleSidebar(true)">☰</button>
          <%- include('home-btn') %>
          <div>
            <div class="crumbs">Home &nbsp;›&nbsp; <%= guildName %> &nbsp;›&nbsp; <%= pageLabel %></div>
            <p class="welcome"><%= pageLabel %></p>
          </div>
        </div>
        <div class="btn-row">
          <a href="https://discord.com/channels/<%= guildId %>/audit-log" target="_blank" class="ghost-btn"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-3px;margin-right:6px;flex-shrink:0;"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>Audit Logs</a>
          <button type="button" class="glossy-btn" onclick="location.reload()"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-3px;margin-right:6px;flex-shrink:0;"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>Sync</button>
        </div>
      </div>

      <% if (saved) { %><div class="banner"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-3px;margin-right:6px;flex-shrink:0;"><polyline points="20 6 9 17 4 12"/></svg>Settings saved.</div><% } %>
      <% if (error) { %><div class="banner error"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-3px;margin-right:6px;flex-shrink:0;"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg><%= error %></div><% } %>
      <% if (!botInGuild) { %><div class="banner error"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-3px;margin-right:6px;flex-shrink:0;"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>The bot isn't in this server right now — live stats and role/channel dropdowns won't be available.</div><% } %>
