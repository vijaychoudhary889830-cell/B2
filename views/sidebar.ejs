<style>
  /* ── Sidebar layout (scoped to .sidebar; nothing else on the page changes) ── */
  .sidebar {
    width: min(290px, 84vw); padding: 16px 14px 18px; gap: 0;
    background: #0b090d;
    border-right: 1px solid var(--border);
    font-family: ui-monospace, 'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace;
    scrollbar-width: thin; scrollbar-color: rgba(255,59,78,0.35) transparent;
  }
  @media (min-width: 901px) { .sidebar { width: 264px; background: #0b090d; } }
  .sidebar .sidebar-close { color: var(--red2); margin-bottom: 0; font-size: 18px; }
  .sidebar .side-brand { display: flex; align-items: center; gap: 11px; padding: 2px 6px 14px; font-weight: 800; font-size: 15px; letter-spacing: .04em; color: #ffffff; }
  .sidebar .brand-logo-box {
    width: 40px; height: 40px; flex-shrink: 0; padding: 2px; border-radius: 12px;
    background: linear-gradient(135deg, var(--red2), var(--red));
    box-shadow: 0 4px 14px rgba(255,59,78,0.35);
  }
  .sidebar .brand-logo-box img { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 10px; }

  .sidebar .side-server {
    display: flex; align-items: center; gap: 10px; padding: 9px 10px; margin: 0 0 6px;
    background: rgba(255,59,78,0.10); border: 1px solid rgba(255,59,78,0.38); border-radius: 12px;
  }
  .sidebar .side-server img, .sidebar .side-server .ph {
    width: 34px; height: 34px; border-radius: 9px; object-fit: cover; flex-shrink: 0;
    background: var(--card2); color: var(--red2); font-weight: 800; font-size: 12px;
    display: flex; align-items: center; justify-content: center;
  }
  .sidebar .side-server-text { flex: 1; min-width: 0; line-height: 1.25; }
  .sidebar .side-server-kicker { font-size: 9.5px; letter-spacing: .12em; color: var(--muted); text-transform: uppercase; font-weight: 700; }
  .sidebar .side-server-name { font-size: 13.5px; font-weight: 800; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sidebar .side-swap { color: var(--red2); background: none; border: none; width: auto; height: auto; font-size: 17px; text-decoration: none; padding: 0 2px; }
  .sidebar .all-servers { display: block; padding: 6px 12px 10px; font-size: 12px; font-weight: 700; color: var(--red2); text-decoration: none; }
  .sidebar .all-servers:hover { color: var(--red2); }

  .sidebar .side-actions { flex-direction: row; gap: 6px; margin: 0 0 4px; }
  .sidebar .side-actions .side-action-btn { width: 100%; justify-content: center; font-family: inherit; font-size: 11px; padding: 8px 6px; border-radius: 9px; }
  .sidebar .side-actions > a.side-action-btn { flex: 1; }
  .sidebar .side-action-btn.audit { background: rgba(255,59,78,0.10); color: var(--red2); border: 1px solid rgba(255,59,78,0.30); }

  .sidebar .side-label { font-size: 10px; letter-spacing: .14em; color: #7f93ab; padding: 16px 12px 6px; font-weight: 800; }
  .sidebar .nav-item {
    gap: 12px; padding: 10px 12px; margin: 1px 0; border-radius: 10px; border: 1px solid transparent; border-left: 1px solid transparent;
    color: #cfe4ff; font-size: 13.5px; font-weight: 600; letter-spacing: .01em;
  }
  .sidebar .nav-item .ic { width: 20px; height: 20px; background: none; border-radius: 0; color: var(--red2); }
  .sidebar .nav-item .ic svg { width: 17px; height: 17px; }
  .sidebar .nav-item:hover { background: rgba(255,59,78,0.10); color: #fff; }
  .sidebar .nav-item.active {
    background: linear-gradient(90deg, rgba(255,59,78,0.34), rgba(255,59,78,0.12));
    border-color: rgba(255,59,78,0.65); color: #fff; box-shadow: 0 0 0 1px rgba(255,59,78,0.08) inset, 0 6px 18px rgba(255,59,78,0.18);
  }
  .sidebar .nav-item.active .ic { background: none; color: #ffffff; }
  .sidebar .sidebar-foot { margin-top: auto; padding: 16px 12px 0; border-top: 1px solid rgba(255,59,78,0.14); }
  .sidebar .sidebar-foot a { color: #cfe4ff; font-size: 12.5px; font-weight: 700; }
</style>
  <div class="drawer-overlay" id="sidebarOverlay" onclick="toggleSidebar(false)"></div>
